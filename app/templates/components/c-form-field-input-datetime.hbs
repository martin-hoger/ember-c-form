{{c-form-field-input-date
    label=label
    model=model
    field=field
    description=description
    minDate=minDate
    maxDate=maxDate
    required=required
    disabled=disabled
    showAudit=showAudit
    class=class
    time=time
    useUTC=false
    action=(action "setTime")
    inputless=inputless
    placeholder=placeholder
}}

{{input
  type="time"
  step="60"
  value=time
  class="form-field-time-picker"
  placeholder=placeholder
}}
